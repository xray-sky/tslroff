<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN"
   "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">

<head>
  <title><%= page_title %></title>
  <link rel="stylesheet" type="text/css" media="screen" href="/typewritten.css" />
  <link rel="stylesheet" type="text/css" media="screen" href="/Manual/tslroff.css" />
  <link rel="stylesheet" type="text/css" media="print"  href="/tsl-print.css" />
  <meta charset="UTF-8">
  <meta name="generator" content="https://github.com/xray-sky/tslroff">
  <meta name="generated" content="<%= Time.now.strftime('%Y%m%d %H:%M:%S') %>">
</head>

<body>
<div id="left">
	<div id="menu">
		<div class="menu_title">
			<h1>Museum</h1>
		</div>
		<div class="menu">

          	<p><a href="/"><item>Home</item></a></p>
         	<p><a href="/Systems/"><item>Lab Overview</item></a></p>
         	<p><a href="/Articles/"><item>Retrotechnology Articles</item></a></p>
         	<p><a href="/Manual/"><item>Online Manuals</item></a></p>
			<p class="here"><small>&rArr; <%= ident %></small></p>
         	<p><a href="/Media/"><item>Media Vault</item></a></p>
          	<p><a href="/Software/"><item>Software Library</item></a></p>
          	<p><a href="/Projects/"><item>Restoration Projects</item></a></p>
          	<p><a href="/wanted.html"><item>Artifacts Sought</item></a></p>

		</div>

<%# don't render this menu if it is empty, or there's only one section heading -%>
      <% if ixinfo.size > 1 -%>
		<div class="menu_title">
			<h1>Anchors</h1>
		</div>
		<div class="menu">

         <% ixinfo.keys.sort.each do |sec|
              next if sec.nil? or sec.empty? -%>
           <p><a href="#section_<%= sec %>"><item><%= names.call(sec) %></item></a></p>
         <% end -%>
       <% end -%>
		</div>
	</div>
</div>

<div id="right">
<div id="content">
<div class="title"><h1><%= page_title %></h1></div>
<div class="body">
<div id="man">

<div class="apropos">
<form>
  <label for="apropos" style="margin-left:2.5em;"><strong>apropos:</strong></label>
  <input name="apropos" id="apropos" type="text" oninput="redraw()"/>
  <em><span id="matched"></span> <span id="indexed"><%= ixinfo.reduce(0) { |total, h| total + h[1].size } %></span> entries</em>
</form>
</div>

<% ixinfo.keys.sort.each do |sec|
     # avoid taking e.g. curses_intro if intro exists, but fall back if not (e.g. take Ultrix 2.0 (1P) spmsintro)
     intro = ixinfo[sec].keys.detect { |f| f&.end_with? '/intro.html' } or ixinfo[sec].keys.detect { |f| f&.end_with? 'intro.html' }
     unless sec.nil? or sec.empty? -%>
    <h2 class="section">
    <a name="section_<%= sec %>"><%= names.call(sec) %><%= %( <small><a href=./#{intro}>(intro)</a></small>) if intro %></a>
    </h2>
     <% end -%>
    <table class="index">
     <% ixinfo[sec].keys.sort.each do |f|
          shortname = File.basename(f).delete_suffix('.html')
          namelist = ixinfo[sec][f][:names]
          #altnames = namelist&.any? && (namelist.length > 1 || namelist[0] != shortname) ? namelist.join(', ') : ''
          altnames = namelist&.any? && (namelist.length > 1 || namelist[0] != shortname) ? namelist.reject { |n| n == shortname } : [] -%>
      <tr><td><%= "#{altnames.join(', ')}, " if altnames.any? %><a href="./<%= f %>"><%= shortname %></a></td><td><%= ixinfo[sec][f][:description] %></td><!-- td><%#= altnames %></td --></tr>
     <% end -%>
    </table>
<% end -%>


    </div>
</div>

	<div class="bottom_deco">
		<table><tr><td class="left"></td><td></td><td class="right"></td></tr></table>
	</div>
</div>

	<div id="footer">

		<p>Typewritten Software &bull;
		<a href="mailto:bear@typewritten.org">bear@typewritten.org</a> &bull;
		Edmonds, WA 98026</p>

	</div>
</div>
</body>
</html>

<script type="text/javascript" src="/Manual/apropos.js"></script>
